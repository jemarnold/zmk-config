#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

&sk {
    release-after-ms = <1000>;
    quick-release;
};

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            bindings = <&mo>, <&kp>;
        };
        htr: right_hand_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        swap: swapper {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <3>;
        };
        dt_esc_alt_f4: double_tap_esc_alt_f4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESCAPE>, <&kp LA(F4)>;
        };

// equal sign operators
        spaced_equal: spaced_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE>;
        };
        spaced_equality: spaced_equality {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp EQUAL &kp SPACE>;
        };
        spaced_unequal: spaced_unequal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EXCL &kp EQUAL &kp SPACE>;
        };
        dt_equal_ops: double_tap_equal_operators {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&spaced_equal>, <&spaced_equality>, <&spaced_unequal>;
        };

        gte: greater_than_equal_to {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN &kp EQUAL>;
        };
        lte: less_than_equal_to {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp EQUAL>;
        };

        dt_assign_pipe: double_tap_assign_pipe {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RA(MINUS)>, <&kp LC(LS(M))>;
        };

        spaced_minus: spaced_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp SPACE>;
        };
        dt_minus_spaced_minus: dt_minus_spaced_minus {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&spaced_minus>;
        };
    };

// modified shift keys
    comma_semicol: comma_semicolon {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA>, <&kp SEMICOLON>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    dot_colon: dot_colon {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT>, <&kp COLON>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    excl_qmark: exclamation_question_mark {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp EXCL>, <&kp QMARK>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    lt_lte: less_than_less_than_equal_to {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LESS_THAN>, <&lte>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    gt_gte: greater_than_greater_than_equal_to {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp GREATER_THAN>, <&gte>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    paren_open_closed: parenthesis_open_closed {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    bracket_open_closed: bracket_open_closed {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    brace_open_closed: brace_open_closed {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    hash_dollar: hash_dollar {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp HASH>, <&kp DOLLAR>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    amp_percent: ampersand_percent {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp AMPERSAND>, <&kp PERCENT>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    at_caret: at_caret {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp AT_SIGN>, <&kp CARET>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    underscore_cmd: underscore_command_palette {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp UNDERSCORE>, <&kp LC(LS(P))>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    slash_pipe: slash_pipe {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp SLASH>, <&kp PIPE>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    backslash_astrk: backslash_asterisk {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp BACKSLASH>, <&kp ASTERISK>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q         &kp W       &kp E                  &kp R         &kp T              &kp Y         &kp U         &kp I                   &kp O        &kp P
&htl LWIN A  &htl LALT S  &htl LC(LEFT_SHIFT) D  &htl LCTRL F  &kp G              &kp H         &htr RCTRL J  &htr RC(RIGHT_SHIFT) K  &htr RALT L  &htr K_APPLICATION APOSTROPHE
&kp Z         &kp X       &kp C                  &kp V         &kp B              &kp N         &kp M         &comma_semicol          &dot_colon   &excl_qmark
                                                 &sk LSHIFT    &lt 1 BACKSPACE    &lt 2 SPACE   &lt 3 ENTER
            >;
        };

        nav-sym {
            bindings = <
&dt_esc_alt_f4  &kp LC(W)        &swap        &kp LS(TAB)        &kp LC(T)           &dt_assign_pipe       &dt_equal_ops       &hash_dollar  &kp LC(LS(C))  &underscore_cmd
&kp TAB         &kp LS(LC(TAB))  &kp LC(TAB)  &kp LC(BACKSPACE)  &kp DELETE          &paren_open_closed    &amp_percent        &at_caret     &kp GRAVE      &backslash_astrk
&kp LC(Z)       &kp LC(X)        &kp LC(C)    &kp LC(V)          &kp LC(Y)           &bracket_open_closed  &brace_open_closed  &lt_lte       &gt_gte        &slash_pipe
                                              &trans             &trans              &trans                &trans
            >;
        };

        fn-num {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5     &kp PLUS   &kp N7  &kp N8  &kp N9  &dt_minus_spaced_minus
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp ASTERISK
&trans  &trans  &trans  &kp F11  &kp F12    &kp DOT    &kp N1  &kp N2  &kp N3  &kp SLASH
                        &trans   &trans     &trans     &kp N0
            >;
        };

        sym-nav {
            bindings = <
&kp GRAVE    &kp EXCLAMATION  &kp AT_SIGN    &kp HASH        &kp DOLLAR       &kp LC(HOME)  &kp HOME      &kp UP      &kp END        &kp PG_UP
&kp PERCENT  &kp CARET        &kp AMPERSAND  &kp UNDERSCORE  &kp PIPE         &kp LC(END)   &kp LEFT      &kp DOWN    &kp RIGHT      &kp PG_DN
&trans       &trans           &trans         &trans          &kp BACKSLASH    &trans        &kp LC(LEFT)  &kp LC(UP)  &kp LC(RIGHT)  &kp LC(DOWN_ARROW)
                                             &trans          &trans           &trans        &trans
            >;
        };

        sys {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_CLR      &kp C_VOL_UP  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_BRIGHTNESS_INC
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &out OUT_BLE    &kp C_VOL_DN  &trans          &trans            &trans      &kp C_BRIGHTNESS_DEC
&soft_off      &sys_reset     &bootloader    &trans         &out OUT_USB    &kp C_MUTE    &trans          &bootloader       &sys_reset  &soft_off
                                             &trans         &trans          &trans        &trans
            >;
        };
    };
};
