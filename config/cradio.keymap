/*
 * Sweep (cradio) keymap
 *
 * Layout: 3x5 + 4 thumb keys per half
 * 
 * Copyright (c) 2022 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 */

/* ------------------------------------------------------------------ *
 *  Layer indices
 * ------------------------------------------------------------------ */
#define BASE    0
#define NAV_SYM 1
#define FN_NUM  2
#define NAV_NAV 3
#define SYS     4

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/* ------------------------------------------------------------------ *
 *  Physical key-position groups
 * ------------------------------------------------------------------ */
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

/* -------------------------------------------------------------------- *
 *  Node-generator helpers: #define macros expand to standard ZMK nodes
 * -------------------------------------------------------------------- */

/* Shift mod-morph: tap -> DEFAULT, either shift held -> SHIFTED */
#define MORPH(NAME, DEFAULT, SHIFTED) \
    NAME: NAME { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <DEFAULT>, <SHIFTED>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    };

/* Windows desktop/app swapper (tri-state): hold LWIN, tap KEY, release */
#define WINSWAP(NAME, KEY) \
    NAME: NAME { \
        compatible = "zmk,behavior-tri-state"; \
        #binding-cells = <0>; \
        bindings = <&kt LWIN>, <&kp KEY>, <&kt LWIN>; \
    };

/ {
    behaviors {

    /* ------------------------------------------------------------ *
     *  Hold-taps & layer taps
     * ------------------------------------------------------------ */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            bindings = <&mo>, <&kp>;
        };
        slt: space_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            bindings = <&mo>, <&kp>;
        };
        htl: left_hand_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <235>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        htr: right_hand_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

    /* ------------------------------------------------------------ *
     *  Tap-dances
     * ------------------------------------------------------------ */
        dt_esc_alt_f4: double_tap_esc_alt_f4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp ESCAPE>, <&kp LA(F4)>;
        };
        dt_equal_ops: double_tap_equal_operators {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&spaced_equal>, <&spaced_equality>, <&spaced_unequal>;
        };
        dt_r_assign: double_tap_r_assign_right {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&r_assign_pipe>, <&r_assign_right>;
        };
        dt_lt_gt: double_tap_lt_gt_spaced_ops {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt_gt>, <&spaced_lte_gte>;
        };
        dt_in_null_or: double_tap_in_null_or {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&spaced_in>, <&spaced_null_or>;
        };
        dt_minus: double_tap_minus_emdash {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&minus_spaced_minus>, <&emdash_spaced_emdash>;
        };

    /* ------------------------------------------------------------ *
     *  Windows swappers (tri-state)
     * ------------------------------------------------------------ */
        alt_tab: swapper_alt_tab {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <3>;
        };
        WINSWAP(win_1, N1)
        WINSWAP(win_2, N2)
        WINSWAP(win_3, N3)
        WINSWAP(win_4, N4)
        WINSWAP(win_5, N5)
        WINSWAP(win_6, N6)
        WINSWAP(win_7, N7)
        WINSWAP(win_8, N8)
        WINSWAP(win_9, N9)
        WINSWAP(win_0, N0)

    /* ------------------------------------------------------------ *
     *  System macros
     * ------------------------------------------------------------ */
        shutdown_win: shutdown_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp LG(X)>, <&macro_wait_time 300>, <&kp LG(X)>, <&kp U>, <&kp U>;
        };
        restart_win: restart_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&kp LG(X)>, <&macro_wait_time 300>, <&kp LG(X)>, <&kp U>, <&kp R>;
        };
        dt_shutdown: double_tap_shutdown {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&shutdown_win>;
        };
        dt_restart: double_tap_restart {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&restart_win>;
        };

    /* ------------------------------------------------------------ *
     *  Spaced-symbol & operator macros
     *
     *  `&macro_release LSHIFT RSHIFT` prefix drops the shift held by a
     *  mod-morph so an unshifted keycode (MINUS/SLASH/EQUAL) isn't corrupted.
     * ------------------------------------------------------------ */

        /* R operators */
        r_assign: r_assign {                      /* " <- " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LESS_THAN &kp MINUS &kp SPACE>;
        };
        r_assign_right: r_assign_right {          /* " -> " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp MINUS &kp GREATER_THAN &kp SPACE>;
        };
        r_pipe: r_pipe {                          /* " |> " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PIPE &kp GREATER_THAN &kp SPACE>;
        };
        spaced_in: spaced_in {                    /* " %in% " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp PERCENT &kp I &kp N &kp PERCENT &kp SPACE>;
        };
        spaced_null_or: spaced_null_or {          /* " %||% " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PERCENT &kp PIPE &kp PIPE &kp PERCENT &kp SPACE>;
        };

        /* Comparison operators */
        spaced_lte: spaced_less_than_equal_to {   /* " <= " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp LESS_THAN &kp EQUAL &kp SPACE>;
        };
        spaced_gte: spaced_greater_than_equal_to { /* " >= " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp GREATER_THAN &kp EQUAL &kp SPACE>;
        };
        spaced_equality: spaced_equality {        /* " == " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp EQUAL &kp SPACE>;
        };
        spaced_unequal: spaced_unequal {          /* " != " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EXCL &kp EQUAL &kp SPACE>;
        };

        /* Spaced math / symbols (shift-release where keycode is unshifted) */
        spaced_equal: spaced_equal {              /* " = " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp EQUAL &kp SPACE>;
        };
        spaced_minus: spaced_minus {              /* " - " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp MINUS &kp SPACE>;
        };
        spaced_plus: spaced_plus {                /* " + " (PLUS is shifted) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PLUS &kp SPACE>;
        };
        spaced_asterisk: spaced_asterisk {        /* " * " (ASTERISK is shifted) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp ASTERISK &kp SPACE>;
        };
        spaced_slash: spaced_slash {              /* " / " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE &kp SLASH &kp SPACE>;
        };

        /* Em-dash via Windows Alt+0151 (NumLock must be ON) */
        emdash: emdash {                          /* "—" */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_press &kp LALT
                        &macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1
                        &macro_release &kp LALT>;
        };
        spaced_emdash: spaced_emdash {            /* " — " */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHIFT &kp RSHIFT
                        &macro_tap &kp SPACE
                        &macro_press &kp LALT
                        &macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1
                        &macro_release &kp LALT
                        &macro_tap &kp SPACE>;
        };
    };

    /* ------------------------------------------------------------ *
     *  Shift mod-morphs (tap = default, either shift = alternate)
     * ------------------------------------------------------------ */

    /* Punctuation / symbol pairs */
    MORPH(comma_semicol,        &kp COMMA,            &kp SEMICOLON)
    MORPH(dot_colon,            &kp DOT,              &kp COLON)
    MORPH(excl_qmark,           &kp EXCL,             &kp QMARK)
    MORPH(paren_open_closed,    &kp LEFT_PARENTHESIS, &kp RIGHT_PARENTHESIS)
    MORPH(bracket_open_closed,  &kp LEFT_BRACKET,     &kp RIGHT_BRACKET)
    MORPH(brace_open_closed,    &kp LEFT_BRACE,       &kp RIGHT_BRACE)
    MORPH(hash_dollar,          &kp HASH,             &kp DOLLAR)
    MORPH(amp_percent,          &kp AMPERSAND,        &kp PERCENT)
    MORPH(at_caret,             &kp AT_SIGN,          &kp CARET)
    MORPH(slash_pipe,           &kp SLASH,            &kp PIPE)
    MORPH(backslash_astrk,      &kp BACKSLASH,        &kp ASTERISK)
    MORPH(lt_gt,                &kp LESS_THAN,        &kp GREATER_THAN)
    MORPH(spaced_lte_gte,       &spaced_lte,          &spaced_gte)
    MORPH(r_assign_pipe,        &r_assign,            &r_pipe)
    MORPH(underscore_cmd,       &kp UNDERSCORE,       &kp LC(LS(P)))

    /* FN_NUM spaced-symbol morphs (tap = symbol, shift = spaced version) */
    MORPH(plus_spaced_plus,         &kp PLUS,     &spaced_plus)
    MORPH(minus_spaced_minus,       &kp MINUS,    &spaced_minus)
    MORPH(emdash_spaced_emdash,     &emdash,      &spaced_emdash)
    MORPH(asterisk_spaced_asterisk, &kp ASTERISK, &spaced_asterisk)
    MORPH(slash_spaced_slash,       &kp SLASH,    &spaced_slash)
    MORPH(equal_spaced_equal,       &kp EQUAL,    &spaced_equal)

    /* ------------------------------------------------------------ *
     *  Conditional layers (NAV_SYM + FN_NUM held -> SYS)
     * ------------------------------------------------------------ */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        system {
            if-layers = <NAV_SYM FN_NUM>;
            then-layer = <SYS>;
        };
    };

    /* ------------------------------------------------------------ *
     *  Keymap
     * ------------------------------------------------------------ */
    keymap {
        compatible = "zmk,keymap";

        /* BASE - alpha + home-row mods + thumb layer-taps */
        BASE {
            label = "BASE";
            bindings = <
&kp Q        &kp W        &kp E             &kp R         &kp T                   &kp Y              &kp U         &kp I             &kp O        &kp P
&htl LWIN A  &htl LALT S  &htl LC(LSHFT) D  &htl LCTRL F  &kp G                   &kp H              &htr RCTRL J  &htr RC(RSHFT) K  &htr RALT L  &htr K_APP APOS
&kp Z        &kp X        &kp C             &kp V         &kp B                   &kp N              &kp M         &comma_semicol    &dot_colon   &excl_qmark
                                            &kp LSHIFT    &lt NAV_SYM BSPC        &slt FN_NUM SPACE  &lt NAV_NAV ENTER
            >;
        };

        /* NAV_SYM - editing shortcuts + programming symbols */
        NAV_SYM {
            label = "NAV_SYM";
            bindings = <
&dt_esc_alt_f4  &kp LC(W)        &alt_tab     &kp LS(TAB)   &kp LC(T)        &dt_r_assign          &dt_equal_ops       &hash_dollar  &kp LC(LS(C))   &underscore_cmd
&kp TAB         &kp LS(LC(TAB))  &kp LC(TAB)  &kp LC(BSPC)  &kp DEL          &paren_open_closed    &amp_percent        &at_caret     &kp GRAVE       &backslash_astrk
&kp LC(Z)       &kp LC(X)        &kp LC(C)    &kp LC(V)     &kp LC(Y)        &bracket_open_closed  &brace_open_closed  &dt_lt_gt     &dt_in_null_or  &slash_pipe
                                              &trans        &trans           &trans                &trans
            >;
        };

        /* FN_NUM - F-keys + numpad & spaced math operators */
        FN_NUM {
            label = "FN_NUM";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                 &plus_spaced_plus    &kp N7  &kp N8  &kp N9  &dt_minus
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                &equal_spaced_equal  &kp N4  &kp N5  &kp N6  &asterisk_spaced_asterisk
&trans  &trans  &trans  &kp F11  &kp F12                &kp DOT              &kp N1  &kp N2  &kp N3  &slash_spaced_slash
                        &trans   &trans                 &trans               &kp N0
            >;
        };

        /* NAV_NAV - window swappers + arrow navigation */
        NAV_NAV {
            label = "NAV_NAV";
            bindings = <
&win_6  &win_7  &win_8  &win_9  &win_0                &kp LC(HOME)  &kp HOME      &kp UP      &kp END        &kp PG_UP
&trans  &trans  &trans  &trans  &trans                &kp LC(END)   &kp LEFT      &kp DOWN    &kp RIGHT      &kp PG_DN
&win_1  &win_2  &win_3  &win_4  &win_5                &trans        &kp LC(LEFT)  &kp LC(UP)  &kp LC(RIGHT)  &kp LC(DOWN_ARROW)
                        &trans  &trans                &trans        &trans
            >;
        };

        /* SYS - BT/output + media & power */
        SYS {
            label = "SYS";
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_CLR          &kp C_VOL_UP  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_BRIGHTNESS_INC
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &out OUT_BLE        &kp C_VOL_DN  &trans          &trans            &trans      &kp C_BRIGHTNESS_DEC
&dt_shutdown   &dt_restart    &bootloader    &sys_reset     &out 1              &kp C_MUTE    &sys_reset      &bootloader       &trans      &trans
                                             &trans         &trans              &trans        &trans
            >;
        };
    };
};
